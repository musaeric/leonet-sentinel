{
  "name": "leonet-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "LeoNet Sentinel — Device monitoring and defense agent for LeoNet Defense",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "vite build",
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "electron": "npm run build && electron .",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && SENTINEL_DEV=true electron .\""
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.leonet.sentinel",
    "productName": "LeoNet Sentinel",
    "icon": "assets/icon",
    "mac": { "category": "public.app-category.utilities", "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "files": ["dist/**/*", "electron/**/*", "server/**/*", "node_modules/**/*"]
  }
}
